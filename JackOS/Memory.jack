/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
    field int heap, freeList;
    static Array ram;

    /** Initializes the class. */
    function void init() {
        let heap = 2048; // heapBase
        let freeList = 2048;
        let heap[0] = 0; // freeList.next
        let heap[1] = 14335; // freeList.size (size of segment)

        let ram = 0;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return ram[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let ram[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function int alloc(int size) {
        var int addr, block;
        var boolean segmentFound;
        let addr = freeList;
        let segmentFound = false;

        if (size < 1) {
            do Sys.error(5); // Allocated memory size must be positive 
        }

        while (~segmentFound) {
            if (ram[addr + 1] > (size + 1)) { // uses first-fit search (as opposed to best-fit)
                let segmentFound = true;
            } else {
                // if at final segment, then fail
                if (ram[addr] = 0) { // WARNING: Assumes next property is zero if last segment in freeList.
                    do Sys.error(6); // Heap overflow 
                    // If defragmentation added, here is where defragmentation could be attempted.
                } else {
                    ram[addr] = addr; // Same as addr.next = addr;
                }
            }
        }

        let block = (addr + ram[addr + 1] + 2) - (size + 2); // find block's location
        let ram[addr + 1] = ram[addr + 1] - (size + 2);  // shorten the size of the free segment
        let ram[block + 1] = size;                 // set size of block
        let ram[block] = 0;                                // set block.next to 0

        return (block + 2); // return start location of segment (after the next and size values)
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var int addr;
        // loop through linkedList until addr.next is 0, then set it to the location of the array and set array.next to zero
        let addr = freeList;
        while ( ~(ram[addr] = 0) ) {
            addr = ram[addr]; // addr = addr.next;
        }
        ram[addr] = ram[o - 2]; // addr.next = segment location of Array o;
        ram[o - 2] = 0; // o.next = 0;
    }    
}
