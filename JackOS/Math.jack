/**
 *  A library of commonly used mathematical functions.
 *  All functions runs in O(n), where n is the number of bits used
 *  for representing a two's complement integer value (16 in the Hack computer). 
 *  Note: Jack compilers implement multiplication and division
 *  using calls to OS functions in this class.
 */
class Math {
    static int n;             // Number of bits used for representing a two's complement integer
    static Array powersOfTwo; // Stores 2^0, 2^1, 2^2,..., 2^(n-1)

    // Initializes the Math library.
    function void init() {
        let n = 16;
        int powersOfTwo = Array.new(16,
            0, 1, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768);
    }

    /** Returns the product of x and y. 
     *  When a Jack compiler detects the multiplication operator '*'
     *  in an expression, it handles it by invoking this method. 
     *  Thus, in Jack, x * y and Math.multiply(x,y) return the same value. */
    function int multiply(int x, int y) {
        var int sum, shiftedX, iter;
        let sum = 0;
        let shiftedX = x;
        let iter = 0;

        // Loops through for each bit of y, and moves shiftedX to the left.
        // Then multiplies shiftedX by the corresponding bit of i and add it to the sum.
        // If the corresponding y-bit = 0 then if will zero out the shiftedX temporarily.
        while(iter < n) {
            if (bit(shiftedX, iter) = 1) {
                sum = sum + shiftedX;
            }
            // Same as shiftedX * 2, which is the same as bit-shift left.
            shiftedX = shiftedX + shiftedX;

            iter = iter + 1; // iterate iter
        }
        return sum;
    }

    // Returns true if the i-th bit of x is 1, false otherwise.
    function boolean bit(int x, int i) {
        if ((x & powersOfTwo[i]) > 0) {
            return 1;
        } else {
            return 0;
        }
    }

    /** Returns the integer part of x / y.
     *  When a Jack compiler detects the division operator '/'
     *  an an expression, it handles it by invoking this method.
     *  Thus, x/y and Math.divide(x,y) return the same value. */
    function int divide(int x, int y) {
        var int q, posX, posY;
        boolean negative;
        let negative = false;
        if (x < 0) {
            let negative = ~negative;
        }
        if (y < 0) {
            let negative = ~negative;
        }
        let posX = Math.abs(x);
        let posY = Math.abs(y);

        if (posX = posY) {
            if (negative) {
                return -1;
            } else {
                return 1;
            }
        }

        if (posY > posX) {return 0;}

        let q = Math.divideRecursive(posX, 2 * posY);
        if ((posX - 2 * q * posY) < posY) {
            let q = 2 * q;
        } else {
            let q = 2 * q + 1;
        }

        if (negative) {
            return -q;
        } else {
            return q;ß
        }
    }

    function int divideRecursive(int x, int y) {
        var int q;

        if ((y > x) | (y < 0)) {return 0;}

        let q = Math.divideRecursive(x, 2 * y);
        if ((x - (2 * q * y)) < y) {
            return 2 * q;
        } else {
            return 2 * q + 1;
        }
    }

    /** Returns the integer part of the square root of x. */
    function int sqrt(int x) {
        var int y, j;
        let y = 0;
        let j = (n/2) - 1;
        while (j > 0) {
            if ( ((y + powersOfTwo[j])*(y + powersOfTwo[j])) < (x + 1) ) {
                let y = y + powersOfTwo[j];
            }

            let j = j - 1;
        }
        return y
    }

    /** Returns the greater value. */
    function int max(int a, int b) {
        if (a > b) {
            return a;
        } else {
            return b;
        }
    }

    /** Returns the smaller value. */
    function int min(int a, int b) {
        if (a < b) {
            return a;
        } else {
            return b;
        }
    }

    /** Returns the absolute value of x. */
    function int abs(int x) {
        if (x < 0) { // Inverts x if it's less than 0.
            return -x;
        }
        return x;
    }
}
